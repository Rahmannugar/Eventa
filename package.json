{
  "name": "eventa",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "admin:provision:identity": "sh services/identity-service/scripts/provision-admin.sh",
    "build": "turbo run build",
    "db:migrate:identity": "docker compose run --rm --build identity-migration",
    "db:migrate:notification": "docker compose run --rm --build notification-migration",
    "db:reset:all": "docker compose down --volumes && pnpm services:start",
    "db:reset:identity": "docker compose down && docker volume rm eventa_identity-database-data && pnpm services:start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "proto:breaking": "pnpm --filter @eventa/grpc-contracts proto:breaking",
    "proto:check": "pnpm --filter @eventa/grpc-contracts proto:check",
    "proto:generate": "pnpm --filter @eventa/grpc-contracts proto:generate",
    "services:cleanup": "sh scripts/finish-services-start.sh",
    "services:logs": "docker compose logs -f",
    "services:start": "docker compose up --build -d && pnpm services:cleanup",
    "services:start:no-build": "docker compose up -d --no-build && pnpm services:cleanup",
    "services:status": "docker compose ps -a",
    "services:stop": "docker compose down",
    "test": "turbo run test",
    "test:all": "pnpm test && pnpm test:integration",
    "test:integration": "pnpm test:integration:identity && pnpm test:integration:gateway && pnpm test:integration:notification",
    "test:integration:gateway": "docker compose up -d api-gateway-redis && pnpm --filter @eventa/api-gateway test:integration",
    "test:integration:identity": "docker compose up -d identity-database identity-redis job-queue && pnpm --filter @eventa/identity-service test:integration",
    "test:integration:notification": "docker compose up -d notification-database job-queue && pnpm --filter @eventa/notification-service test:integration",
    "test:unit:gateway": "pnpm --filter @eventa/api-gateway test:unit",
    "test:unit:identity": "pnpm --filter @eventa/identity-service test:unit",
    "test:unit:notification": "pnpm --filter @eventa/notification-service test:unit",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:all && pnpm build && pnpm format:check",
    "web:start": "pnpm --filter eventa-app dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^22.20.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
