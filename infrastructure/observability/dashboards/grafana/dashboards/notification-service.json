        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(eventa_service_instance{service_name=\"eventa-notification-service\"})",
          "instant": true,
          "legendFormat": "Notification",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Reporting instances",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Failed, expired, or rejected terminal deliveries as a percentage of non-duplicate terminal outcomes. Scheduled retries are not terminal.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * ((sum(increase(eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\", outcome=~\"failed|expired|rejected\"}[$__range]) + (last_over_time(eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\", outcome=~\"failed|expired|rejected\"}[$__range]) unless eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\", outcome=~\"failed|expired|rejected\"} offset $__range)) or vector(0)) / clamp_min(sum(increase(eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\", outcome=~\"delivered|failed|expired|rejected\"}[$__range]) + (last_over_time(eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\", outcome=~\"delivered|failed|expired|rejected\"}[$__range]) unless eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\", outcome=~\"delivered|failed|expired|rejected\"} offset $__range)), 1))",
          "instant": true,
          "legendFormat": "terminal failures",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Terminal delivery failure rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Time from RabbitMQ delivery until acknowledgement, including bounded infrastructure retries performed while the delivery remains in flight.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 1,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(eventa_job_duration_milliseconds_bucket{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"}[$__range]) + (last_over_time(eventa_job_duration_milliseconds_bucket{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"}[$__range]) unless eventa_job_duration_milliseconds_bucket{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"} offset $__range)))",
          "instant": true,
          "legendFormat": "p95",
          "range": false,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(eventa_job_duration_milliseconds_bucket{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"}[$__range]) + (last_over_time(eventa_job_duration_milliseconds_bucket{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"}[$__range]) unless eventa_job_duration_milliseconds_bucket{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"} offset $__range)))",
          "instant": true,
          "legendFormat": "p99",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Delivery processing latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Active deliveries against this worker's prefetch capacity of 8. Broker backlog is intentionally separate and requires RabbitMQ metrics.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 6 },
              { "color": "red", "value": 8 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(eventa_job_in_flight{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"}) or vector(0)",
          "instant": true,
          "legendFormat": "active of 8",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active delivery jobs",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "jobs/second",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (outcome) ((increase(eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"}[1m]) + (last_over_time(eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"}[1m]) unless eventa_job_count_total{service_name=\"eventa-notification-service\", operation=\"attendee.email_verification.delivery\"} offset 1m)) / 60)",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Delivery job traffic by outcome",
      "type": "timeseries"
    },
    {
