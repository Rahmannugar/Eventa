      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "{project=\"eventa\", service_group=\"worker\", service_name=\"eventa-notification-service\"} | json | event=\"email_verification_delivery_completed\" | outcome=~\"failed|expired|rejected\"",
          "queryType": "range",
