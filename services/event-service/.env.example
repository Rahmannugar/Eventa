POSTGRES_DB=eventa_event
POSTGRES_USER=eventa_event
POSTGRES_PASSWORD=eventa_event_password
DATABASE_URL=postgres://eventa_event:eventa_event_password@event-database:5432/eventa_event
TEST_DATABASE_URL=postgres://eventa_event:eventa_event_password@127.0.0.1:57432/eventa_event_test
RABBITMQ_URL=amqp://eventa:eventa_password@job-queue:5672
TEST_RABBITMQ_URL=amqp://eventa:eventa_password@127.0.0.1:5673
RABBITMQ_CONNECT_TIMEOUT_MS=2000
RABBITMQ_PUBLISH_TIMEOUT_MS=2000
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_R2_BUCKET=eventa-media
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://media.example.com
R2_REQUEST_TIMEOUT_MS=5000
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
HEALTH_PORT=3007
DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-collector:4318
