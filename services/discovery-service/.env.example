POSTGRES_DB=eventa_discovery
POSTGRES_USER=eventa_discovery
POSTGRES_PASSWORD=eventa_discovery_password
DATABASE_URL=postgres://eventa_discovery:eventa_discovery_password@discovery-database:5432/eventa_discovery
