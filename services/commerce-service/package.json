{
  "name": "@eventa/commerce-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:prod": "node dist/database/migrate.js",
    "lint": "eslint src test scripts drizzle.config.ts --max-warnings 0",
    "performance:order-plans": "docker compose -f ../../compose.yaml up -d --wait commerce-database && dotenv -e .env -- node scripts/order-query-plans.mjs",
    "start": "node dist/main.js",
    "test:integration": "dotenv -e .env -- vitest run --no-file-parallelism test/integration",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@eventa/grpc-contracts": "workspace:*",
    "@eventa/observability": "workspace:*",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8"
  }
}
